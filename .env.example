# ==============================================================================
# Environment Configuration Template
# Duplicate this file as '.env' in the project root:
#   Windows CMD:        copy .env.example .env
#   PowerShell / Bash:  cp .env.example .env
# NOTE: Never commit your actual .env file or real secrets into version control!
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Optional External API Keys (Leave blank for zero-key local operation)
# The application functions completely out-of-the-box without any of these keys.
# ------------------------------------------------------------------------------

# NewsAPI (Optional):
# If omitted or left empty, the system automatically falls back to Google News RSS
# which requires NO API key and provides real-time financial headlines.
NEWS_API_KEY=""

# Additional Market Data APIs (Optional):
# Public Yahoo Finance (yfinance) is used by default with zero API keys required.
FINNHUB_API_KEY=""
ALPHAVANTAGE_API_KEY=""

# Reddit Official OAuth API (Optional):
# If omitted or left empty, the system provides curated Indian & Global equity
# discussions and sentiment without crashing or prompting authentication errors.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="StockIntelligence/1.0"

# Sentiment Engine Configuration:
# Active news sentiment is computed locally via the deterministic VADER + Financial Context Engine (<150MB RAM).
# Zero API keys or external Hugging Face tokens are required.

# Offline / Cache Settings (Optional)
USE_OFFLINE_CACHE=false


