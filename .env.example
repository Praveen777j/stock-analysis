# ==============================================================================
# Environment Configuration Template
# Duplicate this file as '.env' in the project root:
#   Windows CMD:        copy .env.example .env
#   PowerShell / Bash:  cp .env.example .env
# NOTE: Never commit your actual .env file or real secrets into version control!
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Optional External API Keys (Leave blank for zero-key local operation)
# The application functions completely out-of-the-box without any of these keys.
# ------------------------------------------------------------------------------

# NewsAPI (Optional):
# If omitted or left empty, the system automatically falls back to Google News RSS
# which requires NO API key and provides real-time financial headlines.
NEWS_API_KEY=""

# Additional Market Data APIs (Optional):
# Public Yahoo Finance (yfinance) is used by default with zero API keys required.
FINNHUB_API_KEY=""
ALPHAVANTAGE_API_KEY=""

# Reddit Official OAuth API (Optional):
# If omitted or left empty, the system provides curated Indian & Global equity
# discussions and sentiment without crashing or prompting authentication errors.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="StockIntelligence/1.0"

# Hugging Face Inference API for FinBERT (Optional):
# When set with a valid Hugging Face User Access Token (read permissions), enables
# genuine FinBERT (ProsusAI/finbert) sentiment inference on news headlines.
# If omitted, invalid, or during inference downtime, FinBERT status is cleanly set to UNAVAILABLE
# and news sentiment automatically falls back to VADER with dynamic weight re-normalization.
HF_TOKEN=""
# Supported router endpoint (defaults to https://router.huggingface.co/hf-inference/models/ProsusAI/finbert)
HF_INFERENCE_ENDPOINT="https://router.huggingface.co/hf-inference/models/ProsusAI/finbert"

# Local ONNX FinBERT Inference (Optional):
# Set to 'true' to run Xenova/finbert locally via Transformers.js (ONNX Runtime CPU).
# NOTE: Requires >= 1 GB RAM (peak RSS ~733MB). Keep 'false' on Render Free Tier (512MB limit) to prevent OOM SIGKILL.
ENABLE_LOCAL_FINBERT=false

# Offline / Cache Settings (Optional)
USE_OFFLINE_CACHE=false


